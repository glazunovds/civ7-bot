<?xml version="1.0" encoding="utf-8"?>
<Mod id="expansion-planner" version="1" xmlns="ModInfo">
  <Properties>
    <Name>LOC_MOD_XPL_NAME</Name>
    <Description>LOC_MOD_XPL_DESCRIPTION</Description>
    <Authors>glazunovzayac</Authors>
    <Package>Mod</Package>
    <AffectsSavedGames>0</AffectsSavedGames>
    <Version>1.0.0</Version>
  </Properties>
  <Dependencies>
    <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
  </Dependencies>
  <References>
    <Mod id="detailed-map-tacks" title="LOC_MOD_DETAILED_MAP_TACKS_NAME"/>
  </References>
  <ActionCriteria>
    <Criteria id="always">
      <AlwaysMet></AlwaysMet>
    </Criteria>
    <Criteria id="dmt-active">
      <ModInUse>detailed-map-tacks</ModInUse>
    </Criteria>
  </ActionCriteria>
  <ActionGroups>
    <ActionGroup id="xpl-shell" scope="shell" criteria="always">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Actions>
        <UpdateDatabase>
          <Item>config/input.xml</Item>
        </UpdateDatabase>
        <UpdateText>
          <Item>text/en_us/InGameText.xml</Item>
          <Item>text/ru_ru/InGameText.xml</Item>
        </UpdateText>
      </Actions>
    </ActionGroup>
    <ActionGroup id="xpl-game" scope="game" criteria="always">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Actions>
        <UpdateText>
          <Item>text/en_us/InGameText.xml</Item>
          <Item>text/ru_ru/InGameText.xml</Item>
        </UpdateText>
        <ImportFiles>
          <Item>ui/hud/xpl-dock.css</Item>
          <Item>ui/hud/xpl-production-tacks.css</Item>
          <Item>ui/icons/xpl-dock.png</Item>
          <Item>ui/panel/xpl-panel.css</Item>
          <Item>ui/panel/xpl-panel.html</Item>
          <Item>ui/core/xpl-adjacency-rules.js</Item>
          <Item>ui/core/xpl-combat.js</Item>
          <Item>ui/core/xpl-component-id.js</Item>
          <Item>ui/core/xpl-constants.js</Item>
          <Item>ui/core/xpl-deals.js</Item>
          <Item>ui/core/xpl-effect-value.js</Item>
          <Item>ui/core/xpl-heap.js</Item>
          <Item>ui/core/xpl-hex.js</Item>
          <Item>ui/core/xpl-placement-model.js</Item>
          <Item>ui/core/xpl-placement-solver.js</Item>
          <Item>ui/core/xpl-popups.js</Item>
          <Item>ui/core/xpl-profiles.js</Item>
          <Item>ui/core/xpl-purchase-advisor.js</Item>
          <Item>ui/core/xpl-rule-book.js</Item>
          <Item>ui/core/xpl-savings.js</Item>
          <Item>ui/core/xpl-scarcity.js</Item>
          <Item>ui/core/xpl-site-pipeline.js</Item>
          <Item>ui/core/xpl-site-roles.js</Item>
          <Item>ui/core/xpl-site-scorer.js</Item>
          <Item>ui/core/xpl-site-selector.js</Item>
          <Item>ui/core/xpl-strategy.js</Item>
          <Item>ui/core/xpl-town-advisor.js</Item>
          <Item>ui/core/xpl-town-focus.js</Item>
          <Item>ui/core/xpl-town-scorer.js</Item>
          <Item>ui/core/xpl-tuning.js</Item>
          <Item>ui/core/xpl-victory-focus.js</Item>
          <Item>ui/core/xpl-victory-levers.js</Item>
          <Item>ui/core/xpl-wonder-race.js</Item>
          <Item>ui/core/xpl-wonder-tiers.js</Item>
          <Item>ui/core/xpl-yields.js</Item>
          <Item>ui/data/xpl-autopilot-choices.js</Item>
          <Item>ui/data/xpl-autopilot-steps.js</Item>
          <Item>ui/data/xpl-autopilot-units.js</Item>
          <Item>ui/data/xpl-building-job.js</Item>
          <Item>ui/data/xpl-city-actions.js</Item>
          <Item>ui/data/xpl-empire-job.js</Item>
          <Item>ui/data/xpl-engine-cache.js</Item>
          <Item>ui/data/xpl-engine-map.js</Item>
          <Item>ui/data/xpl-growth-job.js</Item>
          <Item>ui/data/xpl-map-facts.js</Item>
          <Item>ui/data/xpl-player-facts.js</Item>
          <Item>ui/data/xpl-rules-loader.js</Item>
          <Item>ui/data/xpl-settle-oracle.js</Item>
          <Item>ui/data/xpl-site-job.js</Item>
          <Item>ui/data/xpl-tack-orders.js</Item>
          <Item>ui/data/xpl-town-job.js</Item>
          <Item>ui/data/xpl-victory.js</Item>
          <Item>ui/data/xpl-wonder-job.js</Item>
          <Item>ui/hud/xpl-autopilot-popups.js</Item>
          <Item>ui/hud/xpl-autopilot.js</Item>
          <Item>ui/hud/xpl-dock.js</Item>
          <Item>ui/hud/xpl-growth-advisor.js</Item>
          <Item>ui/hud/xpl-hotkey.js</Item>
          <Item>ui/hud/xpl-production-tacks.js</Item>
          <Item>ui/hud/xpl-recalc-watch.js</Item>
          <Item>ui/hud/xpl-triumph-tracker.js</Item>
          <Item>ui/integrations/xpl-dmt-bridge.js</Item>
          <Item>ui/integrations/xpl-dmt-status.js</Item>
          <Item>ui/integrations/xpl-tack-registry.js</Item>
          <Item>ui/map/xpl-camera.js</Item>
          <Item>ui/map/xpl-food-lens.js</Item>
          <Item>ui/map/xpl-overlay.js</Item>
          <Item>ui/panel/xpl-debug.js</Item>
          <Item>ui/panel/xpl-panel.js</Item>
          <Item>ui/panel/xpl-tab-autopilot.js</Item>
          <Item>ui/panel/xpl-tab-buildings.js</Item>
          <Item>ui/panel/xpl-tab-empire.js</Item>
          <Item>ui/panel/xpl-tab-settlements.js</Item>
          <Item>ui/panel/xpl-tab-towns.js</Item>
          <Item>ui/panel/xpl-tab-wonders.js</Item>
          <Item>ui/services/xpl-advice.js</Item>
          <Item>ui/services/xpl-log.js</Item>
          <Item>ui/services/xpl-scheduler.js</Item>
          <Item>ui/services/xpl-settings.js</Item>
          <Item>ui/services/xpl-state.js</Item>
        </ImportFiles>
        <UIScripts>
          <Item>ui/xpl-main.js</Item>
        </UIScripts>
      </Actions>
    </ActionGroup>
    <ActionGroup id="xpl-game-dmt" scope="game" criteria="dmt-active">
      <Properties>
        <LoadOrder>1010</LoadOrder>
      </Properties>
      <Actions>
        <UIScripts>
          <Item>ui/integrations/xpl-dmt-present.js</Item>
        </UIScripts>
      </Actions>
    </ActionGroup>
  </ActionGroups>
  <LocalizedText>
    <File>text/en_us/ModInfoText.xml</File>
  </LocalizedText>
</Mod>
